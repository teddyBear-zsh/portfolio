---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { name: 'Home', url: '#home' },
  { name: 'Projects', url: '#projects' },
  { name: 'Writing', url: '#blog' },
  { name: 'Experiments', url: '#experiments' },
  { name: 'Open Source', url: '#opensource' },
  { name: 'About', url: '#about' },
];
---
<header class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/90 backdrop-blur-sm font-mono text-sm">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="#" class="font-bold tracking-tight text-text hover:text-primary transition-colors">
      <span class="text-primary mr-1">/</span>hub
    </a>
    
    <nav class="hidden md:flex items-center gap-6">
      <ul class="flex items-center gap-6 text-text-muted">
        {links.map(link => (
          <li>
            <a href={link.url} class="hover:text-primary transition-colors focus:outline-none focus:ring-1 focus:ring-primary">{link.name}</a>
          </li>
        ))}
      </ul>
      <div class="w-px h-4 bg-border"></div>
      <ThemeToggle />
    </nav>
    
    <div class="md:hidden flex items-center gap-4">
      <ThemeToggle />
      <button class="text-text-muted hover:text-text border border-border p-1 bg-surface" aria-label="Open menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>
</header>
