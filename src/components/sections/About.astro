<section id="about" class="py-20 max-w-7xl mx-auto px-6 font-mono">
  <div class="flex items-center gap-4 mb-12 border-b border-border pb-4">
    <h2 class="text-2xl font-bold uppercase tracking-widest text-text">
      <span class="text-primary mr-2">03 /</span> Diagnostics & Subsystems
    </h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="bg-surface/30 border border-border p-6 md:p-8 relative">
      <div class="absolute top-0 right-0 w-8 h-8 border-l border-b border-border bg-surface flex items-center justify-center text-text-muted text-[10px]">SYS</div>
      
      <h3 class="text-lg font-bold text-text uppercase tracking-widest mb-6 flex items-center gap-2">
        <span class="w-2 h-2 bg-accent"></span> Current Operations
