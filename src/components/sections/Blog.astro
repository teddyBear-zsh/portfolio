---
import { articles } from '../../data/blog';
---
<section id="blog" class="py-20 max-w-7xl mx-auto px-6 font-mono">
  <div class="flex items-center gap-4 mb-12 border-b border-border pb-4">
    <h2 class="text-2xl font-bold uppercase tracking-widest text-text">
      <span class="text-primary mr-2">02 /</span> Technical Logs
    </h2>
    <div class="h-px flex-1 bg-border"></div>
    <a href="https://medium.com/@teddyzsh" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-primary hover:text-primary/80 uppercase tracking-widest transition-colors flex items-center gap-1">
      Access Archive <span class="text-[10px]">↗</span>
    </a>
  </div>
  
  <div class="space-y-4">
    {articles.map((article) => (
      <article class="group flex flex-col md:flex-row gap-4 md:gap-8 p-4 border border-border bg-surface/30 hover:bg-surface hover:border-primary/50 transition-all items-start md:items-center relative">
        <!-- left accent line -->
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-transparent group-hover:bg-primary transition-colors"></div>
        
        <div class="w-40 shrink-0 text-xs text-text-muted flex flex-col">
          <span class="uppercase tracking-widest text-text font-bold mb-1">Timestamp</span>
          <span>{article.date}</span>
          <span class="mt-2 uppercase tracking-widest text-text font-bold mb-1">Size</span>
          <span>{article.readTime}</span>
        </div>
        
        <div class="flex-1 border-l-0 md:border-l border-border md:pl-8">
          <h3 class="text-lg font-bold text-text mb-2 group-hover:text-primary transition-colors">
            <a href={article.link} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
              {article.title}
              <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </h3>
          <p class="text-sm text-text-muted mb-3 line-clamp-2">{article.summary}</p>
          <div class="flex flex-wrap gap-2">
            {article.tags.map(tag => (
              <span class="text-[10px] px-2 py-0.5 bg-card border border-border text-text-muted uppercase tracking-widest">#{tag}</span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
