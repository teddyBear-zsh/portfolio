<section id="contact" class="py-20 max-w-7xl mx-auto px-6 font-mono">
  <div class="flex items-center gap-4 mb-12 border-b border-border pb-4">
    <h2 class="text-2xl font-bold uppercase tracking-widest text-text">
      <span class="text-primary mr-2">04 /</span> Communications Interface
    </h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    <div class="bg-surface/30 border border-border p-6 md:p-8 relative">
      <div class="absolute top-0 right-0 w-8 h-8 border-l border-b border-border bg-surface flex items-center justify-center text-text-muted text-[10px]">COM</div>
      
      <h3 class="text-3xl font-bold font-heading mb-6 text-text uppercase tracking-tight">
        Transmit Signal
      </h3>
      <p class="text-sm text-text-muted mb-8 leading-relaxed">
        My communication channels are open for new operational parameters. Whether you have a question about systems architecture or just want to initiate contact, I will attempt to respond as soon as bandwidth permits.
      </p>

      <div class="text-xs text-text-muted space-y-2 uppercase tracking-widest">
        <div class="flex items-center gap-2">
          <span class="text-success animate-pulse">●</span> Status: Receiving transmissions
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary">›</span> Protocol: HTTPS / API
        </div>
      </div>
    </div>

    <form id="contact-form" class="space-y-6 text-left border border-border bg-surface p-6 md:p-8">
      <div class="space-y-4">
        <div>
          <label class="block text-[10px] text-text-muted uppercase tracking-widest mb-1">Operator Name</label>
          <input
            name="name"
            placeholder="Enter designation..."
            class="w-full px-4 py-3 bg-card border border-border text-sm focus:outline-none focus:border-primary transition-colors text-text"
          />
        </div>

        <div>
          <label class="block text-[10px] text-text-muted uppercase tracking-widest mb-1">Reply Address</label>
          <input
            name="email"
            type="email"
            required
            placeholder="Enter email..."
            class="w-full px-4 py-3 bg-card border border-border text-sm focus:outline-none focus:border-primary transition-colors text-text"
          />
        </div>

        <div>
          <label class="block text-[10px] text-text-muted uppercase tracking-widest mb-1">Payload / Message</label>
          <textarea
            name="message"
            required
            placeholder="Enter payload data..."
            rows="5"
            class="w-full px-4 py-3 bg-card border border-border text-sm focus:outline-none focus:border-primary transition-colors text-text resize-none"
          ></textarea>
        </div>
      </div>

      <button
        type="submit"
        class="w-full px-8 py-4 bg-primary text-white text-sm font-bold uppercase tracking-widest hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group"
      >
        <span>Execute Transmission</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </button>
    </form>
  </div>
</section>

<div id="toast" class="fixed bottom-4 right-4 translate-y-20 opacity-0 transition-all duration-300 px-6 py-3 border border-border text-xs uppercase tracking-widest font-mono text-white shadow-lg pointer-events-none z-50"></div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const toast = document.getElementById("toast");

  function showToast(message: string, isError = false) {
    if (!toast) return;
    toast.textContent = `[SYS] ${message}`;
    toast.className = `fixed bottom-4 right-4 transition-all duration-300 px-6 py-3 border text-xs uppercase tracking-widest font-mono shadow-lg z-50 ${isError ? 'bg-danger/20 border-danger text-danger' : 'bg-success/20 border-success text-success'}`;
    
    setTimeout(() => {
      toast.className = "fixed bottom-4 right-4 translate-y-20 opacity-0 transition-all duration-300 px-6 py-3 border border-border text-xs uppercase tracking-widest font-mono text-white shadow-lg pointer-events-none z-50";
    }, 4000);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) btn.disabled = true;

    try {
      const formData = new FormData(form);

      const payload = {
        name: formData.get("name"),
        email: formData.get("email"),
        message: formData.get("message"),
      };

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error("Failed to send message");

      showToast("Transmission successful");
      form.reset();
    } catch (err) {
      showToast("Transmission failed", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>