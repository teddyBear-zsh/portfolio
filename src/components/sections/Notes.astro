---
import { notes } from '../../data/notes';

const TAG_COLOR: Record<string, string> = {
  FIX: 'text-danger',
  SANDBOX: 'text-accent',
  NOTE: 'text-text-muted',
};
---
<div>
  <h3 class="text-sm font-bold uppercase tracking-widest text-text mb-4">Learning / Notes</h3>

  <div class="space-y-3 font-mono text-xs">
    {notes.map((note) => (
      <div class="border-l border-border pl-4">
        <div class="flex flex-wrap items-baseline gap-x-2 text-text-muted">
          <span>[{note.date}]</span>
          <span class={`font-bold ${TAG_COLOR[note.tag]}`}>[{note.tag}]</span>
          <span class="text-text leading-relaxed">{note.text}</span>
        </div>
        {note.links && note.links.length > 0 && (
          <div class="mt-1 flex gap-3">
            {note.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                [{link.label}]
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</div>
