---
import { skills } from '../../data/skills';
---
<div class="font-mono text-sm max-w-md">
  {skills.map((row) => (
    <div class="flex justify-between items-center border-b border-border/50 py-2">
      <span class="text-text-muted">{row.label}</span>
      <span class="text-text">{row.value}</span>
    </div>
  ))}
</div>
