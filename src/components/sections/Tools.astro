---
import { tools, TOOL_CATEGORIES } from '../../data/tools';
---
<div>
  <div class="flex items-center gap-3 mb-4">
    <h3 class="text-sm font-bold uppercase tracking-widest text-text">Tools</h3>
    <span class="inline-flex items-center gap-2 text-[10px] uppercase tracking-widest text-text-muted">
      <span class="w-1.5 h-1.5 rounded-full bg-warning"></span>
      Consolidating
    </span>
  </div>
  <p class="text-xs text-text-muted leading-relaxed mb-6 max-w-xl">
    A catalog of reusable CI/CD configs, tool configs, and scripts, meant for others to copy and adapt.
    Currently scattered across my own system — being consolidated into a public repo one entry at a time.
  </p>

  {tools.length > 0 && (
    <div class="space-y-6">
      {TOOL_CATEGORIES.filter((category) => tools.some((tool) => tool.category === category)).map((category) => (
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-text-muted mb-2">{category}</h4>
          <ul class="space-y-1">
            {tools.filter((tool) => tool.category === category).map((tool) => (
              <li>
                <a href={`/tools/${tool.slug}`} class="flex items-baseline gap-3 text-xs hover:text-primary transition-colors">
                  <span class="text-primary font-bold">{tool.name}</span>
                  <span class="text-text-muted truncate">{tool.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</div>
