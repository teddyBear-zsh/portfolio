---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="border border-border bg-card px-4 py-4 flex flex-col gap-1">
  <span class="text-2xl md:text-3xl font-bold font-heading text-accent leading-none">{value}</span>
  <span class="text-xs text-text-muted uppercase tracking-widest leading-snug">{label}</span>
</div>
