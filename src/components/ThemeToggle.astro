<button id="theme-toggle" class="flex items-center justify-center w-10 h-10 rounded-none border border-border text-muted hover:text-primary transition-colors bg-surface" aria-label="Toggle Theme">
    <span id="theme-icon" class="font-mono text-sm">[L]</span>
</button>

<script>
const root = document.documentElement;
const saved = localStorage.getItem("theme");

// Default to dark for Mission Control theme
if (saved === "light") {
    root.classList.add("light");
    root.classList.remove("dark");
    document.getElementById("theme-icon").textContent = "[D]";
} else {
    root.classList.add("dark");
}

document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isLight = root.classList.contains("light");
    if (isLight) {
        root.classList.remove("light");
        root.classList.add("dark");
        localStorage.setItem("theme", "dark");
        document.getElementById("theme-icon").textContent = "[L]";
    } else {
        root.classList.add("light");
        root.classList.remove("dark");
        localStorage.setItem("theme", "light");
        document.getElementById("theme-icon").textContent = "[D]";
    }
});
</script>