---
interface Node {
  title: string;
  subtitle?: string;
}

interface Props {
  id: string; // unique per instance — used to scope the SVG marker id
  center: Node;
  spokes: Node[];
  caption?: string;
}

const { id, center, spokes, caption } = Astro.props;

// Positions are computed in percent so the diagram scales with its container;
// insets leave a visible gap between hub/spoke boxes for the arrowheads to
// sit in (the boxes themselves aren't clipped against — this is an
// approximation, not a precise geometric intersection).
const RADIUS = 38;
const CENTER_INSET = 13;
const SPOKE_INSET = 12;
const START_ANGLE = -Math.PI / 2;

const angleStep = (2 * Math.PI) / spokes.length;

const points = spokes.map((spoke, i) => {
  const angle = START_ANGLE + i * angleStep;
  const ux = Math.cos(angle);
  const uy = Math.sin(angle);
  const x = 50 + RADIUS * ux;
  const y = 50 + RADIUS * uy;
  return {
    spoke,
    x,
    y,
    lineX1: 50 + ux * CENTER_INSET,
    lineY1: 50 + uy * CENTER_INSET,
    lineX2: x - ux * SPOKE_INSET,
    lineY2: y - uy * SPOKE_INSET,
  };
});

const markerId = `hub-arrow-${id}`;
---

<div class="border border-border bg-surface/30 p-4 md:p-6">
  <div class="relative mx-auto aspect-square w-full max-w-md">
    <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full" aria-hidden="true">
      <defs>
        <marker id={markerId} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto-start-reverse">
          <path d="M2 1L8 5L2 9" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
      </defs>
      {points.map((p) => (
        <line
          x1={p.lineX1}
          y1={p.lineY1}
          x2={p.lineX2}
          y2={p.lineY2}
          stroke="var(--color-border)"
          stroke-width="0.5"
          marker-start={`url(#${markerId})`}
          marker-end={`url(#${markerId})`}
        />
      ))}
    </svg>

    <div class="absolute left-1/2 top-1/2 z-10 min-w-28 -translate-x-1/2 -translate-y-1/2 border border-primary bg-card px-4 py-2 text-center md:min-w-32 md:px-5 md:py-3">
      <p class="text-xs font-bold font-heading uppercase tracking-wide text-text md:text-sm">{center.title}</p>
      {center.subtitle && (
        <p class="mt-0.5 text-[11px] leading-snug text-text-muted md:text-xs">{center.subtitle}</p>
      )}
    </div>

    {points.map((p) => (
      <div
        class="absolute z-10 min-w-20 -translate-x-1/2 -translate-y-1/2 border border-border bg-card px-2 py-1.5 text-center md:min-w-24 md:px-3 md:py-2"
        style={`left:${p.x}%; top:${p.y}%`}
      >
        <p class="text-[10px] font-bold font-heading uppercase tracking-wide text-text md:text-xs">{p.spoke.title}</p>
        {p.spoke.subtitle && (
          <p class="mt-0.5 text-[10px] leading-snug text-text-muted">{p.spoke.subtitle}</p>
        )}
      </div>
    ))}
  </div>

  {caption && (
    <p class="mt-4 border-t border-border/50 pt-3 text-center text-[11px] text-text-muted md:text-xs">{caption}</p>
  )}
</div>
